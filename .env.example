# LLM Provider Configuration
# Supported: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Gemini Provider Settings
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash (Optional fallback; LLM_MODEL takes priority)

# OpenAI Provider Settings (Optional / Legacy)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini (Optional fallback; LLM_MODEL takes priority)

# Mock Mode (For testing without API keys or network calls)
# MOCK_LLM=1
# MOCK_GPT=1 (Legacy alias)
